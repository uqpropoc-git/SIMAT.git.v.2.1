/**
 * BACKEND API - GOOGLE APPS SCRIPT
 */

function doGet(e) {
  const action = e ? e.parameter.action : '';
  
  if (action === 'getHistory') {
    return handleGetHistory();
  } else if (action === 'getOptions') {
    return handleGetOptions();
  }
  
  return respondJSON({ status: 'error', message: 'Action tidak valid' });
}

function doPost(e) {
  try {
    const contents = JSON.parse(e.postData.contents);
    const action = contents.action;

    if (action === 'syncData') {
      return handleSyncData(contents.data);
    }

    return respondJSON({ status: 'error', message: 'Action tidak valid' });
  } catch (err) {
    return respondJSON({ status: 'error', message: err.toString() });
  }
}

// Handler Opsi Dropdown & Detail Master Sumur
function handleGetOptions() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    let sheetMaster = ss.getSheetByName('Master_Sumur');
    
    // Default fallback jika sheet master belum dibuat di Spreadsheet
    let masterSumurData = [
      { sumur: "SP-PITJATAH", lokasi: "0° 38' 46.593\" S - 117° 4' 47.274\" E", tinggiStick: 0.50, kedalaman: 25.00 },
      { sumur: "SP-PIT Z (WSJ)", lokasi: "0° 41' 40.356\" S - 117° 4' 7.545\" E", tinggiStick: 0.60, kedalaman: 30.00 },
      { sumur: "SP-BUG-04", lokasi: "0° 40' 22.416\" S - 117° 3' 11.797\" E", tinggiStick: 0.45, kedalaman: 20.00 },
      { sumur: "SP-BUG-03R", lokasi: "0° 40' 18.801\" S - 117° 3' 6.815\" E", tinggiStick: 0.55, kedalaman: 22.50 },
      { sumur: "SP-BUG-06", lokasi: "0° 41' 13.096\" S - 117° 2' 36.111\" E", tinggiStick: 0.50, kedalaman: 18.00 },
      { sumur: "SP-BUG-05A", lokasi: "0° 41' 8.569\" S - 117° 2' 31.711\" E", tinggiStick: 0.40, kedalaman: 24.00 },
      { sumur: "SP-BUG-01", lokasi: "0° 39' 38.674\" S - 117° 3' 51.496\" E", tinggiStick: 0.50, kedalaman: 15.00 },
      { sumur: "SP-BUG-02", lokasi: "0° 39' 43.852\" S - 117° 3' 58.420\" E", tinggiStick: 0.50, kedalaman: 16.50 }
    ];

    if (sheetMaster) {
      const data = sheetMaster.getDataRange().getValues();
      if (data.length > 1) {
        masterSumurData = [];
        for (let i = 1; i < data.length; i++) {
          if (data[i][0]) {
            masterSumurData.push({
              sumur: data[i][0].toString().trim(),
              lokasi: data[i][1] ? data[i][1].toString().trim() : '',
              tinggiStick: data[i][2] !== '' && !isNaN(parseFloat(data[i][2])) ? parseFloat(data[i][2]) : 0,
              kedalaman: data[i][3] !== '' && !isNaN(parseFloat(data[i][3])) ? parseFloat(data[i][3]) : 0
            });
          }
        }
      }
    } else {
      // Jika sheet Master_Sumur belum ada, otomatis buatkan beserta headernya
      sheetMaster = ss.insertSheet('Master_Sumur');
      sheetMaster.appendRow(['Nama_Sumur', 'Lokasi', 'Tinggi_Stick_Pipa_m', 'Kedalaman_Sumur_m']);
      sheetMaster.getRange("A1:D1").setFontWeight("bold").setBackground("#e2e8f0");
      
      masterSumurData.forEach(item => {
        sheetMaster.appendRow([item.sumur, item.lokasi, item.tinggiStick, item.kedalaman]);
      });
    }

    return respondJSON({
      status: 'success',
      masterSumur: masterSumurData
    });
  } catch (e) {
    return respondJSON({ status: 'error', message: e.toString() });
  }
}

// Handler Sinkronisasi Data dari Client
function handleSyncData(dataArray) {
  if (!dataArray || !Array.isArray(dataArray) || dataArray.length === 0) {
    return respondJSON({ status: 'error', message: 'Data kosong atau format salah.' });
  }

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sheet = ss.getSheetByName('DB_Pengukuran');

  if (!sheet) {
    sheet = ss.insertSheet('DB_Pengukuran');
    sheet.appendRow([
      'ID_Transaksi', 'Tanggal_Waktu', 'Nama_Petugas', 'Nama_Sumur', 
      'Lokasi', 'Latitude', 'Longitude', 'Cuaca', 'Kondisi_Air', 
      'Kondisi_Fisik_Air', 'Tinggi_Stick_Pipa', 'Kedalaman_Sumur', 
      'Pengukuran_1', 'Pengukuran_2', 'Pengukuran_3', 'Rata_Rata_Kedalaman', 
      'Total_MAT', 'Link_Folder_Foto', 'Status_Sync'
    ]);
    sheet.getRange("A1:S1").setFontWeight("bold").setBackground("#e2e8f0");
  }

  const rootFolder = getOrCreateFolder("FOTO_SUMUR_PANTAU");
  let successIds = [];

  dataArray.forEach(data => {
    let folderUrl = "-";
    
    if (data.fotos && Array.isArray(data.fotos) && data.fotos.length > 0) {
      const folderName = `${data.namaSumur}_${data.idTransaksi}`.replace(/[/\\?%*:|"<>]/g, '_');
      const subFolder = rootFolder.createFolder(folderName);
      folderUrl = subFolder.getUrl();

      data.fotos.forEach((fileBase64, index) => {
        if (fileBase64 && fileBase64.includes(',')) {
          const splitData = fileBase64.split(',');
          const contentType = splitData[0].match(/:(.*?);/)[1];
          const bytes = Utilities.base64Decode(splitData[1]);
          const ext = contentType.includes('video') ? 'mp4' : 'jpg';
          const blob = Utilities.newBlob(bytes, contentType, `Dokumentasi_${index + 1}.${ext}`);
          subFolder.createFile(blob);
        }
      });
    }

    const timeStamp = data.tanggalWaktu || Utilities.formatDate(new Date(), "Asia/Jakarta", "yyyy-MM-dd HH:mm:ss");

    sheet.appendRow([
      data.idTransaksi || '-',
      timeStamp,
      data.namaPetugas || '-',
      data.namaSumur || '-',
      data.lokasi || '-',
      data.lat || '-',
      data.lng || '-',
      data.cuaca || '-',
      data.kondisiAir || '-',
      data.kondisiFisikAir || '-',
      data.tinggiStickPipa || 0,
      data.kedalamanSumur || 0,
      data.pengukuran1 || 0,
      data.pengukuran2 || 0,
      data.pengukuran3 || 0,
      data.rataRata || 0,
      data.matTotal || 0,
      folderUrl,
      'Synced'
    ]);

    successIds.push(data.idTransaksi);
  });

  return respondJSON({
    status: 'success',
    message: `${successIds.length} data berhasil disimpan ke Database & Drive.`,
    syncedIds: successIds
  });
}

// Handler Mengambil Riwayat
function handleGetHistory() {
  try {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    const sheet = ss.getSheetByName('DB_Pengukuran');
    if (!sheet) return respondJSON({ status: 'success', data: [] });

    const data = sheet.getDataRange().getValues();
    if (data.length <= 1) return respondJSON({ status: 'success', data: [] });

    const rows = data.slice(1).reverse();
    const history = rows.map(row => ({
      id: row[0],
      tanggal: row[1],
      petugas: row[2],
      sumur: row[3],
      lokasi: row[4],
      rataRata: row[15],
      matTotal: row[16],
      driveUrl: row[17]
    }));

    return respondJSON({ status: 'success', data: history });
  } catch (e) {
    return respondJSON({ status: 'error', message: e.toString() });
  }
}

function getOrCreateFolder(folderName) {
  const folders = DriveApp.getFoldersByName(folderName);
  return folders.hasNext() ? folders.next() : DriveApp.createFolder(folderName);
}

function respondJSON(jsonObj) {
  return ContentService.createTextOutput(JSON.stringify(jsonObj))
    .setMimeType(ContentService.MimeType.JSON);
}
